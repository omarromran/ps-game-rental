<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In</title>
    <link rel="stylesheet" href="/cssFiles/login&signup.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="icon" href="/photos/images.png">
    <script src="/jsFiles/toast.js"></script>
    <script type="module" src="/jsFiles/logout.js"></script>
</head>

<body>

    <div class="wrapper">
        <h1>Log In</h1>
        <form id="login-form">

            <div class="input-group">
                <i class="fa-solid fa-envelope"></i>
                <input type="text" name="email" id="email-input" placeholder="Email" autocomplete="off">
            </div>

            <div class="input-group">
                <i class="fa-solid fa-lock"></i>
                <input type="password" name="password" id="password-input" placeholder="Password" autocomplete="new-password">
            </div>

            <p id="error-msg" style="color:red; font-size:0.85rem; display:none;"></p>

            <button type="submit">Log In</button>
            <p>Don't have an account? <a href="/signup">Sign Up</a></p>

        </form>
    </div>

    <script src="/jsFiles/login.js" defer></script>
</body>

</html>